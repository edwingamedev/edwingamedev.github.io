---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Game Developer portfolio" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | Edwin Game Dev</title>
  </head>

  <body class="min-h-screen bg-page text-foreground antialiased">
    <slot />
  </body>
</html>
