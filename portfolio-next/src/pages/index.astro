---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
---

<BaseLayout title="Home">
  <main>
    <Container>
      <div class="flex min-h-screen flex-col justify-center gap-4">
        <p class="text-sm font-medium tracking-widest text-accent">GAME DEVELOPER</p>

        <h1 class="text-5xl font-bold">Hi, I'm Edwin.</h1>

        <p class="max-w-xl text-muted">Building gameplay systems, tools and game experiences.</p>
      </div>
    </Container>
  </main>
</BaseLayout>
