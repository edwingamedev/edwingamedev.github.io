---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero.astro";
import Section from "../components/ui/Section.astro";
import ProjectCarousel from "../components/projects/ProjectCarousel.astro";

const featuredProjects = (await getCollection("projects"))
  .filter((project) => project.data.categories.includes("featured"))
  .sort((a, b) => (a.data.featured_order ?? Infinity) - (b.data.featured_order ?? Infinity));
---

<BaseLayout title="Home">
  <main>
    <Hero />

    <Section id="projects" spacing="compact">
      <div class="mb-6 flex flex-col items-start gap-2 sm:flex-row sm:items-center sm:justify-between">
        <h2 class="text-2xl font-bold sm:text-3xl">Featured Projects</h2>

        <a
          href="/projects/"
          class="inline-flex shrink-0 items-center gap-1 whitespace-nowrap text-sm font-medium text-accent hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          <span>View All Projects</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>

      <ProjectCarousel projects={featuredProjects} />
    </Section>
  </main>
</BaseLayout>
