---
import Section from "../ui/Section.astro";
import Button from "../ui/Button.astro";
---

<Section id="home" spacing="compact">
  <div class="grid items-center gap-10 md:grid-cols-[minmax(0,3fr)_minmax(200px,2fr)]">
    <div class="flex min-w-0 flex-col items-start">
      <p class="mb-4 text-sm font-medium tracking-wide text-accent">Senior Game Developer</p>

      <h1 class="text-4xl leading-tight font-bold tracking-tight sm:text-5xl lg:text-6xl">
        Edwin Holanda
      </h1>

      <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted">
        I build games, develop systems, and solve interesting technical challenges along the way.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <Button href="/projects/">Explore Projects</Button>
        <Button href="#contact" variant="secondary">
          Contact
        </Button>
      </div>
    </div>

    <div class="flex items-center justify-center">
      <img
        src="/assets/images/logo.png"
        alt="Edwin Holanda logo"
        width="280"
        height="280"
        class="h-auto w-full max-w-56 rounded-lg border border-white/20 object-contain md:max-w-70"
      />
    </div>
  </div>
</Section>
