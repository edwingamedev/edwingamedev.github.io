---
import Section from "../ui/Section.astro";
import { UserRound } from "@lucide/astro";
---

<Section id="about" spacing="compact">
  <div class="about-section" aria-labelledby="about-title">
    <div class="section-heading">
      <UserRound size={24} aria-hidden="true" />
      <h2 id="about-title">About Me</h2>
    </div>

    <div class="about-grid">
      <div class="profile-picture">
        <img src="/assets/images/profile.jpg" alt="Edwin Holanda" loading="lazy" />
      </div>

      <div class="about-content">
        <p>
          I'm a game developer with a background in software engineering dating back to 2010. I
          enjoy both the creative and technical sides of making games, from designing mechanics to
          building gameplay systems and tools.
        </p>

        <p>
          I've worked on shipped games, LiveOps features, and development tools, while also creating
          independent games and experimenting with pixel art, game design, and new technologies. I
          enjoy solving problems and being involved in the entire development process.
        </p>
      </div>
    </div>
  </div>
</Section>

<style>
  .section-heading {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 28px;
  }

  .section-heading :global(svg) {
    flex-shrink: 0;
    color: var(--color-accent);
  }

  .section-heading h2 {
    margin: 0;
    color: var(--color-foreground);
    font-size: clamp(21px, 2.5vw, 26px);
    font-weight: 700;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    align-items: center;
    gap: 48px;
  }

  .profile-picture {
    width: 220px;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 2px solid var(--color-border);
    border-radius: 12px;
  }

  .profile-picture img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .about-content {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .about-content p {
    margin: 0;
    color: var(--color-muted);
    font-size: 15px;
    line-height: 1.8;
  }

  @media (max-width: 639px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .profile-picture {
      width: 160px;
    }

    .section-heading {
      margin-bottom: 22px;
    }
  }
</style>