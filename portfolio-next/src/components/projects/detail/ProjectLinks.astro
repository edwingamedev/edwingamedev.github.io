---
import { ExternalLink } from "@lucide/astro";

interface Props {
  instagram?: string[];
  link?: string;
}

const { instagram = [], link } = Astro.props;

function getInstagramUrl(value: string): string | undefined {
  if (/^[A-Za-z0-9_-]+$/.test(value)) {
    return `https://www.instagram.com/p/${value}/`;
  }

  try {
    const url = new URL(value);

    if (!["instagram.com", "www.instagram.com"].includes(url.hostname)) {
      return undefined;
    }

    const [type, id] = url.pathname.split("/").filter(Boolean);

    if (!["p", "reel"].includes(type) || !/^[A-Za-z0-9_-]+$/.test(id ?? "")) {
      return undefined;
    }

    return `https://www.instagram.com/${type}/${id}/`;
  } catch {
    return undefined;
  }
}

const instagramUrls = [
  ...new Set(instagram.map(getInstagramUrl).filter((url): url is string => Boolean(url))),
];

const hasLinks = instagramUrls.length > 0 || Boolean(link);
---

{hasLinks && (
  <section class="project-links" aria-labelledby="project-links-title">
    <div class="section-heading">
      <ExternalLink size={23} aria-hidden="true" />
      <h2 id="project-links-title">More From This Project</h2>
    </div>

    {instagramUrls.length > 0 && (
      <div class="instagram-grid">
        {instagramUrls.map((url) => (
          <blockquote
            class="instagram-media"
            data-instgrm-permalink={url}
            data-instgrm-version="14"
          >
            <a href={url} target="_blank" rel="noopener noreferrer">
              View this post on Instagram
            </a>
          </blockquote>
        ))}
      </div>
    )}

    {link && (
      <a class="project-external-link" href={link} target="_blank" rel="noopener noreferrer">
        <span>Visit Project</span>
        <ExternalLink size={16} aria-hidden="true" />
      </a>
    )}
  </section>
)}

{instagramUrls.length > 0 && (
  <script is:inline async src="https://www.instagram.com/embed.js"></script>
)}

<style>
  .project-links {
    margin-top: 42px;
  }

  .section-heading {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 18px;
  }

  .section-heading :global(svg) {
    flex-shrink: 0;
    color: var(--color-accent);
  }

  .section-heading h2 {
    color: var(--color-foreground);
    font-size: clamp(21px, 2.5vw, 26px);
    line-height: 1.25;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .instagram-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
    margin-bottom: 24px;
  }

  .instagram-grid :global(.instagram-media) {
    margin: 0 !important;
    max-width: 540px;
    min-width: 0 !important;
    width: min(100%, 400px);
  }

  .project-external-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--color-accent);
    font-weight: 600;
    text-decoration: none;
  }

  .project-external-link:hover {
    color: var(--color-accent-hover);
  }

  @media (max-width: 639px) {
    .project-links {
      margin-top: 32px;
    }
  }
</style>
