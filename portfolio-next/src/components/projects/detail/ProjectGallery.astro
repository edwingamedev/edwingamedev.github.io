---
import type { CollectionEntry } from "astro:content";
import { Images, Expand, ChevronLeft, ChevronRight, X } from "@lucide/astro";
import ProjectMedia from "../ProjectMedia.astro";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { title, header, thumbnail, images } = project.data;

const cover = header || thumbnail;
const gallery = [...new Set(images ?? [])].filter((src) => src !== cover);
---

{gallery.length > 0 && (
  <section class="project-gallery project-section" aria-labelledby="gallery-title" data-gallery>
    <div class="gallery-heading">
      <div class="heading-title">
        <Images size={24} aria-hidden="true" />
        <h2 id="gallery-title">Gallery</h2>
      </div>

      <span class="gallery-count">{gallery.length} media</span>
    </div>

    <div class="gallery-grid">
      {gallery.map((src, index) => (
        <button
          type="button"
          class="gallery-item"
          data-gallery-item
          data-src={src}
          data-alt={`${title} media ${index + 1}`}
          aria-label={`Open ${title} media ${index + 1}`}
        >
          <ProjectMedia src={src} alt={`${title} media ${index + 1}`} />

          <span class="expand-icon" aria-hidden="true">
            <Expand size={18} />
          </span>
        </button>
      ))}
    </div>

    <dialog data-gallery-dialog class="gallery-dialog" aria-label={`${title} media gallery`}>
      <div class="lightbox">
        <div class="lightbox-header">
          <span data-gallery-count aria-live="polite">
            1 / {gallery.length}
          </span>

          <button type="button" data-gallery-close class="icon-button" aria-label="Close gallery">
            <X size={22} />
          </button>
        </div>

        <div class="lightbox-stage">
          <button
            type="button"
            data-gallery-prev
            class="icon-button nav-button"
            aria-label="Previous media"
          >
            <ChevronLeft size={28} />
          </button>

          <div data-gallery-preview class="lightbox-preview" />

          <button
            type="button"
            data-gallery-next
            class="icon-button nav-button"
            aria-label="Next media"
          >
            <ChevronRight size={28} />
          </button>
        </div>
      </div>
    </dialog>
  </section>
)}

<style>
  .project-gallery {
    margin-top: 42px;
  }

  .gallery-heading,
  .heading-title {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .gallery-heading {
    justify-content: space-between;
    margin-bottom: 18px;
  }

  .heading-title :global(svg) {
    flex-shrink: 0;
    color: var(--color-accent);
  }

  .heading-title h2 {
    color: var(--color-foreground);
    font-size: clamp(21px, 2.5vw, 26px);
    font-weight: 700;
  }

  .gallery-count {
    color: var(--color-muted);
    font-size: 12px;
    white-space: nowrap;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .gallery-item {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    height: 170px;
    padding: 8px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 9px;
    background: var(--color-surface);
    cursor: zoom-in;
    transition: border-color 180ms ease;
  }

  .gallery-item:hover {
    border-color: var(--color-accent);
  }

  .gallery-item :global(img),
  .gallery-item :global(video) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .expand-icon {
    position: absolute;
    right: 10px;
    bottom: 10px;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    color: var(--color-foreground);
    background: var(--color-page);
  }

  /* Lightbox */
  .gallery-dialog {
    position: fixed;
    inset: 0;
    margin: auto;
    width: min(1100px, 96vw);
    max-width: 96vw;
    max-height: 96dvh;
    padding: 16px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-page);
    color: var(--color-foreground);
  }

  .gallery-dialog::backdrop {
    background: rgb(0 0 0 / 85%);
  }

  .lightbox {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .lightbox-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--color-muted);
    font-size: 13px;
  }

  .lightbox-stage {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) 44px;
    align-items: center;
    gap: 8px;
  }

  .lightbox-preview {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    min-height: 160px;
  }

  .lightbox-preview :global(img),
  .lightbox-preview :global(video) {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 78dvh;
    object-fit: contain;
    border-radius: 6px;
  }

  .icon-button {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    color: var(--color-foreground);
    background: var(--color-surface);
    cursor: pointer;
    transition:
      border-color 180ms ease,
      color 180ms ease;
  }

  .icon-button:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .nav-button {
    justify-self: center;
  }

  @media (min-width: 768px) {
    .gallery-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
    }

    .gallery-item {
      height: 210px;
    }
  }

  @media (max-width: 639px) {
    .project-gallery {
      margin-top: 32px;
    }

    .gallery-item {
      height: 135px;
    }

    .gallery-dialog {
      padding: 8px;
    }

    .lightbox-stage {
      grid-template-columns: 36px minmax(0, 1fr) 36px;
      gap: 4px;
    }

    .nav-button {
      width: 36px;
      height: 44px;
    }

    .lightbox-preview :global(img),
    .lightbox-preview :global(video) {
      max-height: 72dvh;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-gallery]").forEach((gallery) => {
    const items = Array.from(gallery.querySelectorAll<HTMLButtonElement>("[data-gallery-item]"));

    const dialog = gallery.querySelector<HTMLDialogElement>("[data-gallery-dialog]");
    const preview = gallery.querySelector<HTMLElement>("[data-gallery-preview]");
    const counter = gallery.querySelector<HTMLElement>("[data-gallery-count]");
    const previous = gallery.querySelector<HTMLButtonElement>("[data-gallery-prev]");
    const next = gallery.querySelector<HTMLButtonElement>("[data-gallery-next]");
    const close = gallery.querySelector<HTMLButtonElement>("[data-gallery-close]");

    if (!dialog || !preview || !counter || !previous || !next || !close || !items.length) {
      return;
    }

    let currentIndex = 0;
    let touchStartX: number | null = null;

    const normalize = (index: number) => ((index % items.length) + items.length) % items.length;

    const showMedia = (index: number) => {
      currentIndex = normalize(index);

      const item = items[currentIndex];
      const src = item.dataset.src;
      if (!src) return;

      // Remove a mídia anterior, inclusive vídeo em reprodução.
      preview.replaceChildren();

      if (/\.(webm|mp4)(?:[?#]|$)/i.test(src)) {
        const video = document.createElement("video");
        video.src = src;
        video.controls = true;
        video.playsInline = true;
        video.preload = "metadata";
        video.setAttribute("aria-label", item.dataset.alt ?? "");
        preview.append(video);
      } else {
        const image = document.createElement("img");
        image.src = src;
        image.alt = item.dataset.alt ?? "";
        preview.append(image);
      }

      counter.textContent = `${currentIndex + 1} / ${items.length}`;
    };

    items.forEach((item, index) => {
      item.addEventListener("click", () => {
        showMedia(index);
        dialog.showModal();
      });
    });

    previous.addEventListener("click", () => showMedia(currentIndex - 1));
    next.addEventListener("click", () => showMedia(currentIndex + 1));
    close.addEventListener("click", () => dialog.close());

    dialog.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        showMedia(currentIndex - 1);
      } else if (event.key === "ArrowRight") {
        event.preventDefault();
        showMedia(currentIndex + 1);
      }
    });

    preview.addEventListener(
      "touchstart",
      (event) => {
        touchStartX = event.changedTouches[0]?.clientX ?? null;
      },
      { passive: true }
    );

    preview.addEventListener(
      "touchend",
      (event) => {
        if (touchStartX === null) return;

        const endX = event.changedTouches[0]?.clientX;
        if (endX === undefined) return;

        const distance = endX - touchStartX;
        touchStartX = null;

        if (Math.abs(distance) < 50) return;

        showMedia(currentIndex + (distance < 0 ? 1 : -1));
      },
      { passive: true }
    );

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.addEventListener("close", () => {
      preview.replaceChildren();
      touchStartX = null;
    });
  });
</script>
