---
import Container from "../ui/Container.astro";
import ThemeSwitcher from "../ui/ThemeSwitcher.astro";

const navigation = [
  { label: "Projects", href: "/projects/" },
  { label: "About", href: "/#about" },
  { label: "Contact", href: "/#contact" },
];
---

<header class="sticky top-0 z-50 border-b border-border bg-page">
  <Container>
    <div class="flex min-h-16 items-center justify-between gap-4">
      <a
        href="/"
        class="shrink-0 font-bold tracking-wide text-foreground focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
        aria-label="Edwin Game Dev - Home"
      >
        EDWIN<span class="text-accent">.DEV</span>
      </a>

      <!-- Desktop -->
      <div class="hidden items-center gap-6 md:flex">
        <nav class="flex items-center gap-6" aria-label="Main navigation">
          {navigation.map((item) => (
            <a href={item.href} class="text-sm text-foreground transition-colors hover:text-accent">
              {item.label}
            </a>
          ))}
        </nav>

        <div class="border-l border-border pl-6">
          <ThemeSwitcher />
        </div>
      </div>

      <!-- Mobile -->
      <div class="flex items-center gap-3 md:hidden">
        <ThemeSwitcher />

        <details class="mobile-menu relative">
          <summary
            class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-md border border-border text-foreground"
            aria-label="Open navigation menu"
          >
            <span aria-hidden="true">☰</span>
          </summary>

          <nav
            aria-label="Mobile navigation"
            class="absolute top-12 right-0 z-50 flex min-w-44 flex-col rounded-lg border border-border bg-surface p-3 shadow-lg"
          >
            {navigation.map((item) => (
              <a
                href={item.href}
                class="rounded-md px-3 py-2 text-sm text-foreground hover:bg-surface-raised hover:text-accent"
              >
                {item.label}
              </a>
            ))}
          </nav>
        </details>
      </div>
    </div>
  </Container>
</header>
