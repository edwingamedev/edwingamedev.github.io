---
import { navigation } from "../../data/navigation";

interface Props {
  variant?: "desktop" | "mobile";
}

const { variant = "desktop" } = Astro.props;

const base = import.meta.env.BASE_URL;

const resolveHref = (href: string) => {
  if (!href.startsWith("/")) return href;

  return `${base.replace(/\/$/, "")}${href}`;
};

const linkClasses = {
  desktop:
    "text-label text-foreground transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent",

  mobile:
    "rounded-md px-3 py-2 text-label text-foreground transition-colors hover:bg-surface-raised hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent",
};
---

<nav
  aria-label={variant === "desktop" ? "Main navigation" : "Mobile navigation"}
  class:list={[
    "flex",
    variant === "desktop"
      ? "items-center gap-6"
      : "flex-col",
  ]}
>
  {navigation.map((item) => (
    <a href={resolveHref(item.href)} class={linkClasses[variant]}>
      {item.label}
    </a>
  ))}
</nav>
