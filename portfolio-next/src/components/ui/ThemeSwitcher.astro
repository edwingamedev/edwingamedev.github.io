<label class="inline-flex items-center gap-2 text-sm text-muted">
  <span class="hidden sm:inline">Theme</span>

  <select
    data-theme-switcher
    aria-label="Choose color theme"
    class="w-24 cursor-pointer rounded-md border border-border bg-surface px-2 py-2 text-xs text-foreground focus-visible:outline-2 focus-visible:outline-accent sm:w-auto sm:px-3 sm:text-sm"
  >
    <option value="atari-dark">Atari Dark</option>
    <option value="atari-classic">Atari Classic</option>
    <option value="retro-purple">Retro Purple</option>
  </select>
</label>

<script>
  const selectors = document.querySelectorAll<HTMLSelectElement>("[data-theme-switcher]");

  selectors.forEach((selector) => {
    selector.value = document.documentElement.dataset.theme ?? "atari-dark";

    selector.addEventListener("change", () => {
      const theme = selector.value;

      document.documentElement.dataset.theme = theme;

      try {
        localStorage.setItem("portfolio-theme", theme);
      } catch {
        // Storage may be unavailable.
      }
    });
  });
</script>
