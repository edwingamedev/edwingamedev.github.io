---
import type { CollectionEntry } from "astro:content";
import { ChevronLeft, ChevronRight } from "@lucide/astro";
import ProjectCartridge from "./ProjectCartridge.astro";

interface Props {
  projects: CollectionEntry<"projects">[];
}

const { projects } = Astro.props;

const POOL_SIZE = 7;
const CENTER_SLOT = 3;

const getProject = (index: number) => {
  const total = projects.length;
  const wrapped = ((index % total) + total) % total;

  return projects[wrapped]!;
};

const initialPool = projects.length
  ? Array.from({ length: POOL_SIZE }, (_, index) => getProject(index - CENTER_SLOT))
  : [];
---

{projects.length === 1 ? (
  <div class="single-project">
    <ProjectCartridge project={projects[0]!} />
  </div>
) : projects.length > 1 ? (
  <div class="project-carousel" data-carousel data-project-count={projects.length}>
    <div class="carousel-viewport" data-viewport>
      <div class="carousel-track" data-track tabindex="0" aria-label="Featured projects carousel">
        {initialPool.map((project, index) => (
          <div
            class:list={["carousel-slot", { "is-selected": index === CENTER_SLOT }]}
            data-pool-slot
            inert={index === 0 || index === POOL_SIZE - 1}
            aria-hidden={index === 0 || index === POOL_SIZE - 1 ? "true" : undefined}
          >
            <ProjectCartridge project={project} />
          </div>
        ))}
      </div>

      <button
        class="carousel-arrow carousel-arrow-prev"
        data-prev
        type="button"
        aria-label="Previous featured project"
      >
        <ChevronLeft size={24} aria-hidden="true" />
      </button>

      <button
        class="carousel-arrow carousel-arrow-next"
        data-next
        type="button"
        aria-label="Next featured project"
      >
        <ChevronRight size={24} aria-hidden="true" />
      </button>
    </div>

    <div class="carousel-indicators">
      {projects.map((project, index) => (
        <button
          class="carousel-indicator"
          data-indicator
          type="button"
          aria-label={`Select ${project.data.title}`}
          aria-current={index === 0 ? "true" : undefined}
        >
          <span class="carousel-indicator-dot" aria-hidden="true"></span>
        </button>
      ))}
    </div>

    <div class="carousel-templates" aria-hidden="true">
      {projects.map((project, index) => (
        <template data-project-template={index}>
          <ProjectCartridge project={project} />
        </template>
      ))}
    </div>
  </div>
) : null}

<style>
  .project-carousel {
    --carousel-card-width: 280px;
    --carousel-gap: 24px;
    --carousel-step: calc(var(--carousel-card-width) + var(--carousel-gap));

    width: 100%;
  }

  .single-project {
    display: flex;
    justify-content: center;
  }

  .carousel-viewport {
    position: relative;
    width: 100%;

    /*
           * Four complete steps give us:
           * half + full + full + full + half.
           */
    max-width: calc(var(--carousel-step) * 4);
    margin-inline: auto;
    overflow: hidden;
  }

  .carousel-track {
    position: relative;

    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;

    width: max-content;
    gap: var(--carousel-gap);
    padding-block: 18px;

    touch-action: pan-y;
    user-select: none;
    cursor: grab;
  }

  .carousel-track:active {
    cursor: grabbing;
  }

  .carousel-slot {
    flex: 0 0 var(--carousel-card-width);
    width: var(--carousel-card-width);

    opacity: 0.6;
    transition: opacity 180ms ease;
  }

  .carousel-slot.is-selected {
    opacity: 1;
  }

  .carousel-arrow {
    position: absolute;
    top: 50%;
    z-index: 10;

    display: flex;
    align-items: center;
    justify-content: center;

    width: 44px;
    height: 44px;

    border: 0;
    border-radius: 6px;

    background: var(--color-page);
    color: var(--color-foreground);

    cursor: pointer;
    transform: translateY(-50%);
    transition: color 180ms ease;
  }

  .carousel-arrow:hover {
    color: var(--color-accent);
  }

  .carousel-arrow:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }

  .carousel-arrow-prev {
    left: 0;
  }

  .carousel-arrow-next {
    right: 0;
  }

  .carousel-indicators {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;

    gap: 0;
    margin-top: 12px;
  }

  .carousel-indicator {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 32px;
    width: 32px;
    height: 44px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .carousel-indicator-dot {
    width: 14px;
    height: 10px;

    border: 1px solid var(--color-border);
    border-radius: 2px;

    background: var(--color-border-strong);

    transition:
      width 180ms ease,
      background 180ms ease;
  }

  .carousel-indicator:hover .carousel-indicator-dot {
    background: var(--color-surface-raised);
  }

  .carousel-indicator[aria-current="true"] .carousel-indicator-dot {
    width: 26px;
    background: var(--color-accent);
  }

  .carousel-indicator:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }

  .carousel-templates {
    display: none;
  }

  @media (max-width: 767px) {
    .project-carousel {
      --carousel-gap: 16px;
    }

    .carousel-arrow {
      width: 40px;
      height: 40px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel-slot,
    .carousel-arrow,
    .carousel-indicator-dot {
      transition: none;
    }
  }
</style>

<script>
  const CENTER_SLOT = 3;
  const POOL_SIZE = 7;

  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((carousel) => {
    const viewport = carousel.querySelector<HTMLElement>("[data-viewport]");
    const track = carousel.querySelector<HTMLElement>("[data-track]");

    const slots = Array.from(carousel.querySelectorAll<HTMLElement>("[data-pool-slot]"));

    const templates = Array.from(
      carousel.querySelectorAll<HTMLTemplateElement>("[data-project-template]")
    );

    const indicators = Array.from(carousel.querySelectorAll<HTMLButtonElement>("[data-indicator]"));

    const previous = carousel.querySelector<HTMLButtonElement>("[data-prev]");
    const next = carousel.querySelector<HTMLButtonElement>("[data-next]");

    const total = Number(carousel.dataset.projectCount);

    if (
      !viewport ||
      !track ||
      total < 2 ||
      slots.length !== POOL_SIZE ||
      templates.length !== total
    ) {
      return;
    }

    type Direction = -1 | 1;

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    // State

    let currentIndex = 0;
    let moving: Direction | 0 = 0;
    let targetIndex: number | null = null;

    let activePointer: number | null = null;
    let startX = 0;
    let dragX = 0;
    let dragging = false;
    let position = 0;
    let lastDraggedAt = -Infinity;

    // Indexing

    const wrap = (index: number): number => ((index % total) + total) % total;

    // Geometry

    const xFor = (index: number): number => {
      const slot = slots[index];

      return viewport.clientWidth / 2 - (slot.offsetLeft + slot.offsetWidth / 2);
    };

    const setX = (x: number) => {
      position = x;
      track.style.transform = `translate3d(${x}px, 0, 0)`;
    };

    // UI

    const selectSlot = (index: number) => {
      slots.forEach((slot, i) => {
        slot.classList.toggle("is-selected", i === index);
      });
    };

    const syncIndicators = () => {
      indicators.forEach((indicator, index) => {
        if (index === currentIndex) {
          indicator.setAttribute("aria-current", "true");
        } else {
          indicator.removeAttribute("aria-current");
        }
      });
    };

    const syncAccessibility = () => {
      slots.forEach((slot, index) => {
        const hidden = index === 0 || index === POOL_SIZE - 1;

        slot.toggleAttribute("inert", hidden);

        if (hidden) {
          slot.setAttribute("aria-hidden", "true");
        } else {
          slot.removeAttribute("aria-hidden");
        }
      });
    };

    // Pool

    const fillSlot = (slot: HTMLElement, index: number) => {
      const template = templates[wrap(index)];

      slot.replaceChildren(template.content.cloneNode(true));
    };

    const setPool = (index: number) => {
      currentIndex = wrap(index);
      track.style.transition = "none";

      slots.forEach((slot, i) => {
        fillSlot(slot, currentIndex + i - CENTER_SLOT);
      });

      selectSlot(CENTER_SLOT);
      setX(xFor(CENTER_SLOT));

      syncIndicators();
      syncAccessibility();

      void track.offsetWidth;
      track.style.transition = "";
    };

    // Complete movement and recycle exactly one slot

    const finishStep = () => {
      if (!moving) return;

      const direction = moving;

      track.style.transition = "none";

      if (direction === 1) {
        const recycled = slots.shift()!;

        track.append(recycled);
        slots.push(recycled);

        currentIndex = wrap(currentIndex + 1);

        fillSlot(recycled, currentIndex + CENTER_SLOT);
      } else {
        const recycled = slots.pop()!;

        track.prepend(recycled);
        slots.unshift(recycled);

        currentIndex = wrap(currentIndex - 1);

        fillSlot(recycled, currentIndex - CENTER_SLOT);
      }

      selectSlot(CENTER_SLOT);
      setX(xFor(CENTER_SLOT));

      syncIndicators();
      syncAccessibility();

      moving = 0;

      // Rebase only the transform, without animation.
      void track.offsetWidth;
      track.style.transition = "";

      if (targetIndex !== null && currentIndex !== targetIndex) {
        requestAnimationFrame(advanceToTarget);
      } else {
        targetIndex = null;
      }
    };

    // Move by one pooled slot

    const step = (direction: Direction) => {
      if (moving) return;

      moving = direction;
      selectSlot(CENTER_SLOT + direction);

      const destination = xFor(CENTER_SLOT + direction);

      track.style.transition = reducedMotion.matches ? "none" : "transform 280ms ease";

      if (reducedMotion.matches || Math.abs(destination - position) < 0.5) {
        setX(destination);
        finishStep();
        return;
      }

      setX(destination);
    };

    // Indicator navigation

    function advanceToTarget() {
      if (moving || targetIndex === null) return;

      const forward = wrap(targetIndex - currentIndex);

      if (forward === 0) {
        targetIndex = null;
        return;
      }

      const backward = forward - total;

      const difference = Math.abs(forward) <= Math.abs(backward) ? forward : backward;

      // Large jumps do not animate through the whole dataset.
      if (Math.abs(difference) > CENTER_SLOT) {
        setPool(targetIndex);
        targetIndex = null;
        return;
      }

      step(difference > 0 ? 1 : -1);
    }

    const goTo = (index: number) => {
      if (dragging || moving) return;

      targetIndex = wrap(index);
      advanceToTarget();
    };

    // Animation completion

    track.addEventListener("transitionend", (event) => {
      if (event.target === track && event.propertyName === "transform") {
        finishStep();
      }
    });

    // Buttons

    previous?.addEventListener("click", () => {
      if (moving) return;

      targetIndex = null;
      step(-1);
    });

    next?.addEventListener("click", () => {
      if (moving) return;

      targetIndex = null;
      step(1);
    });

    // Indicators

    indicators.forEach((indicator, index) => {
      indicator.addEventListener("click", () => goTo(index));
    });

    // Pointer interaction

    track.addEventListener("pointerdown", (event) => {
      if (event.button !== 0 || moving) return;

      activePointer = event.pointerId;
      startX = event.clientX;

      dragX = 0;
      dragging = false;
    });

    track.addEventListener("pointermove", (event) => {
      if (event.pointerId !== activePointer) return;

      const delta = event.clientX - startX;

      if (!dragging && Math.abs(delta) < 6) return;

      if (!dragging) {
        dragging = true;
        track.setPointerCapture(event.pointerId);
        track.style.transition = "none";
      }

      if (event.cancelable) {
        event.preventDefault();
      }

      const center = xFor(CENTER_SLOT);

      // Never expose empty space beyond the buffer slots.
      const bounded = Math.max(
        xFor(CENTER_SLOT + 1),
        Math.min(xFor(CENTER_SLOT - 1), center + delta)
      );

      dragX = bounded - center;
      setX(bounded);
    });

    const endPointer = (event: PointerEvent, cancelled: boolean) => {
      if (event.pointerId !== activePointer) return;

      activePointer = null;

      if (!dragging) return;

      dragging = false;
      lastDraggedAt = performance.now();

      if (track.hasPointerCapture(event.pointerId)) {
        track.releasePointerCapture(event.pointerId);
      }

      const threshold = slots[CENTER_SLOT].offsetWidth / 4;

      if (!cancelled && Math.abs(dragX) >= threshold) {
        targetIndex = null;
        step(dragX < 0 ? 1 : -1);
      } else {
        track.style.transition = reducedMotion.matches ? "none" : "transform 280ms ease";

        setX(xFor(CENTER_SLOT));
      }
    };

    track.addEventListener("pointerup", (event) => {
      endPointer(event, false);
    });

    track.addEventListener("pointercancel", (event) => {
      endPointer(event, true);
    });

    track.addEventListener("dragstart", (event) => {
      event.preventDefault();
    });

    // Prevent opening a project after dragging.

    track.addEventListener(
      "click",
      (event) => {
        if (performance.now() - lastDraggedAt < 300) {
          event.preventDefault();
          event.stopPropagation();
        }
      },
      true
    );

    // Keyboard

    track.addEventListener("keydown", (event) => {
      if (event.target !== track) return;

      if (event.key === "ArrowLeft") {
        event.preventDefault();
        targetIndex = null;
        step(-1);
      } else if (event.key === "ArrowRight") {
        event.preventDefault();
        targetIndex = null;
        step(1);
      }
    });

    // Resize

    const resizeObserver = new ResizeObserver(() => {
      if (moving || dragging) return;

      track.style.transition = "none";
      setX(xFor(CENTER_SLOT));
    });

    resizeObserver.observe(viewport);

    // Initialization

    track.style.transition = "none";

    setX(xFor(CENTER_SLOT));
    syncIndicators();
    syncAccessibility();
  });
</script>
