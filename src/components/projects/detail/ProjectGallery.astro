---
import type { CollectionEntry } from "astro:content";
import { Images, Expand, ChevronLeft, ChevronRight, X, Play } from "@lucide/astro";
import ProjectMedia from "../ProjectMedia.astro";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { title, header, thumbnail, images } = project.data;

const cover = header || thumbnail;
const gallery = [...new Set(images ?? [])].filter((src) => src !== cover);
const isVideo = (src: string) => /\.(webm|mp4)(?:[?#]|$)/i.test(src);
---

{gallery.length > 0 && (
  <section class="project-gallery project-section" aria-labelledby="gallery-title" data-gallery>
    <div class="gallery-heading">
      <div class="heading-title">
        <Images size={24} aria-hidden="true" />
        <h2 id="gallery-title">Gallery</h2>
      </div>

      <span class="gallery-count">{gallery.length} media</span>
    </div>

    <!-- Thumbnail carousel -->
    <div class="gallery-carousel">
      <button
        type="button"
        data-strip-prev
        class="carousel-arrow carousel-arrow-prev"
        aria-label="Previous gallery items"
      >
        <ChevronLeft size={24} aria-hidden="true" />
      </button>

      <div data-gallery-track class="gallery-track" aria-label="Project media">
        {gallery.map((src, index) => (
          <button
            type="button"
            class="gallery-item"
            data-gallery-item
            data-src={src}
            data-alt={`${title} media ${index + 1}`}
            aria-label={`Open ${title} media ${index + 1}`}
          >
            <ProjectMedia src={src} alt={`${title} media ${index + 1}`} />

            {isVideo(src) && (
              <span class="video-indicator" aria-hidden="true">
                <Play size={18} fill="currentColor" />
              </span>
            )}

            <span class="expand-icon" aria-hidden="true">
              <Expand size={18} />
            </span>
          </button>
        ))}
      </div>

      <button
        type="button"
        data-strip-next
        class="carousel-arrow carousel-arrow-next"
        aria-label="Next gallery items"
      >
        <ChevronRight size={24} aria-hidden="true" />
      </button>
    </div>

    <!-- Fullscreen lightbox -->
    <dialog data-gallery-dialog class="gallery-dialog" aria-label={`${title} media gallery`}>
      <div class="lightbox">
        <div class="lightbox-header">
          <span data-gallery-count aria-live="polite">
            1 / {gallery.length}
          </span>

          <button type="button" data-gallery-close class="icon-button" aria-label="Close gallery">
            <X size={22} aria-hidden="true" />
          </button>
        </div>

        <div class="lightbox-stage">
          <button
            type="button"
            data-gallery-prev
            class="icon-button nav-button"
            aria-label="Previous media"
          >
            <ChevronLeft size={28} aria-hidden="true" />
          </button>

          <div data-gallery-preview class="lightbox-preview" />

          <button
            type="button"
            data-gallery-next
            class="icon-button nav-button"
            aria-label="Next media"
          >
            <ChevronRight size={28} aria-hidden="true" />
          </button>
        </div>
      </div>
    </dialog>

    <!-- Lucide icon reused by dynamically created videos -->
    <template data-play-icon>
      <Play size={48} fill="currentColor" aria-hidden="true" />
    </template>
  </section>
)}

<style>
  /* Section */
  .project-gallery {
    margin-top: 42px;
  }

  .gallery-heading,
  .heading-title {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .gallery-heading {
    justify-content: space-between;
    margin-bottom: 18px;
  }

  .heading-title :global(svg) {
    flex-shrink: 0;
    color: var(--color-accent);
  }

  .heading-title h2 {
    color: var(--color-foreground);
    font-size: clamp(21px, 2.5vw, 26px);
    font-weight: 700;
  }

  .gallery-count {
    color: var(--color-muted);
    font-size: 12px;
    white-space: nowrap;
  }

  /* Thumbnail carousel */
  .gallery-carousel {
    position: relative;
  }

  .gallery-track {
    display: flex;
    gap: 16px;
    width: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .gallery-track::-webkit-scrollbar {
    display: none;
  }

  .gallery-item {
    position: relative;
    display: flex;
    flex: 0 0 calc((100% - 32px) / 3);
    align-items: center;
    justify-content: center;
    min-width: 0;
    height: 210px;
    padding: 0;
    overflow: hidden;
    scroll-snap-align: start;
    border: 2px solid transparent;
    border-radius: 9px;
    background: transparent;
    cursor: zoom-in;
    transition: border-color 180ms ease;
  }

  .gallery-item:hover,
  .gallery-item:focus-visible {
    border-color: var(--color-accent);
  }

  .gallery-item :global(img),
  .gallery-item :global(video) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Thumbnail controls */
  .carousel-arrow {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-border-strong);
    border-radius: 50%;
    background: var(--color-page);
    color: var(--color-foreground);
    transform: translateY(-50%);
    cursor: pointer;
    transition:
      border-color 180ms ease,
      color 180ms ease;
  }

  .carousel-arrow:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .carousel-arrow:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .carousel-arrow:disabled {
    opacity: 0;
    pointer-events: none;
  }

  .carousel-arrow-prev {
    left: -22px;
  }

  .carousel-arrow-next {
    right: -22px;
  }

  .carousel-arrow[hidden],
  .nav-button[hidden] {
    display: none;
  }

  /* Thumbnail overlays */
  .expand-icon {
    position: absolute;
    right: 10px;
    bottom: 10px;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    color: var(--color-foreground);
    background: var(--color-page);
  }

  .video-indicator {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    pointer-events: none;
  }

  .video-indicator :global(svg) {
    width: 42px;
    height: 42px;
    padding: 11px;
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    box-shadow: 0 2px 12px var(--color-border);
  }

  /* Fullscreen lightbox */
  .gallery-dialog {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
    border: none;
    border-radius: 0;
    background: transparent;
    color: var(--color-foreground);
  }

  .gallery-dialog::backdrop {
    background: var(--color-page);
  }

  .lightbox {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .lightbox-header {
    position: absolute;
    inset: 0 0 auto;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 24px;
    color: var(--color-foreground);
    pointer-events: none;
  }

  .lightbox-header .icon-button {
    pointer-events: auto;
  }

  .lightbox-stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  .lightbox-preview {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    min-width: 0;
    padding: 72px 80px 32px;
  }

  .lightbox-preview :global(img),
  .lightbox-preview :global(video) {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: 0;
  }

  .lightbox-preview :global(.video-preview) {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    min-height: 0;
    background: transparent;
  }

  .lightbox-preview :global(.video-play-indicator) {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    pointer-events: none;
    color: var(--color-accent);
  }

  .lightbox-preview :global(.video-play-indicator svg) {
    width: 48px;
    height: 48px;
    padding: 0;
    border: none;
    background: transparent;
    filter: drop-shadow(0 2px 6px var(--color-page));
  }

  .lightbox-preview :global(.video-play-indicator[hidden]) {
    display: none;
  }

  /* Lightbox controls */
  .icon-button {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    color: var(--color-foreground);
    background: var(--color-surface);
    cursor: pointer;
    transition:
      border-color 180ms ease,
      color 180ms ease;
  }

  .icon-button:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .nav-button {
    position: absolute;
    top: 50%;
    z-index: 10;
    transform: translateY(-50%);
  }

  .nav-button[data-gallery-prev] {
    left: 20px;
  }

  .nav-button[data-gallery-next] {
    right: 20px;
  }

  /* Mobile */
  @media (max-width: 639px) {
    .project-gallery {
      margin-top: 32px;
    }

    .gallery-track {
      gap: 12px;
    }

    .gallery-item {
      flex-basis: 82%;
      height: 170px;
    }

    .gallery-item:only-child {
      flex-basis: 100%;
    }

    .carousel-arrow {
      width: 40px;
      height: 40px;
    }

    .carousel-arrow-prev {
      left: 4px;
    }

    .carousel-arrow-next {
      right: 4px;
    }

    .lightbox-header {
      padding: 12px 16px;
    }

    .lightbox-preview {
      padding: 64px 12px 88px;
    }

    .nav-button {
      top: auto;
      bottom: 16px;
      width: 44px;
      height: 44px;
      transform: none;
    }

    .nav-button[data-gallery-prev] {
      left: 16px;
    }

    .nav-button[data-gallery-next] {
      right: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-track {
      scroll-behavior: auto;
    }

    .gallery-item,
    .carousel-arrow,
    .icon-button {
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-gallery]").forEach((gallery) => {
    const items = Array.from(gallery.querySelectorAll<HTMLButtonElement>("[data-gallery-item]"));

    const track = gallery.querySelector<HTMLElement>("[data-gallery-track]");
    const stripPrev = gallery.querySelector<HTMLButtonElement>("[data-strip-prev]");
    const stripNext = gallery.querySelector<HTMLButtonElement>("[data-strip-next]");

    const dialog = gallery.querySelector<HTMLDialogElement>("[data-gallery-dialog]");
    const preview = gallery.querySelector<HTMLElement>("[data-gallery-preview]");
    const counter = gallery.querySelector<HTMLElement>("[data-gallery-count]");
    const previous = gallery.querySelector<HTMLButtonElement>("[data-gallery-prev]");
    const next = gallery.querySelector<HTMLButtonElement>("[data-gallery-next]");
    const close = gallery.querySelector<HTMLButtonElement>("[data-gallery-close]");

    if (
      !track ||
      !stripPrev ||
      !stripNext ||
      !dialog ||
      !preview ||
      !counter ||
      !previous ||
      !next ||
      !close ||
      !items.length
    ) {
      return;
    }

    // Thumbnail carousel
    const updateCarousel = () => {
      const hasOverflow = track.scrollWidth > track.clientWidth + 1;

      stripPrev.hidden = !hasOverflow;
      stripNext.hidden = !hasOverflow;

      if (!hasOverflow) {
        stripPrev.disabled = true;
        stripNext.disabled = true;
        return;
      }

      stripPrev.disabled = track.scrollLeft <= 1;
      stripNext.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 1;
    };

    const moveCarousel = (direction: number) => {
      const firstItem = items[0];
      if (!firstItem) return;

      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      const distance = firstItem.getBoundingClientRect().width + gap;

      track.scrollBy({
        left: distance * direction,
        behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches
          ? "instant"
          : "smooth",
      });
    };

    stripPrev.addEventListener("click", () => moveCarousel(-1));
    stripNext.addEventListener("click", () => moveCarousel(1));

    track.addEventListener("scroll", updateCarousel, { passive: true });

    const resizeObserver = new ResizeObserver(updateCarousel);
    resizeObserver.observe(track);

    // Content and fonts can change the width of the gallery items.
    items.forEach((item) => resizeObserver.observe(item));

    updateCarousel();

    // Fullscreen lightbox
    let currentIndex = 0;
    let touchStartX: number | null = null;

    const normalize = (index: number) => ((index % items.length) + items.length) % items.length;

    const showMedia = (index: number) => {
      currentIndex = normalize(index);

      const item = items[currentIndex];
      const src = item.dataset.src;
      if (!src) return;

      // Stop and remove the previous media.
      preview.replaceChildren();

      if (/\.(webm|mp4)(?:[?#]|$)/i.test(src)) {
        const wrapper = document.createElement("div");
        wrapper.className = "video-preview";

        const video = document.createElement("video");
        video.src = src;
        video.controls = true;
        video.autoplay = true;
        video.muted = true;
        video.playsInline = true;
        video.preload = "auto";
        video.setAttribute("aria-label", item.dataset.alt ?? "");

        const playIndicator = document.createElement("span");
        playIndicator.className = "video-play-indicator";
        playIndicator.setAttribute("aria-hidden", "true");

        const playIcon = gallery.querySelector<HTMLTemplateElement>("[data-play-icon]");

        if (playIcon) {
          playIndicator.append(playIcon.content.cloneNode(true));
        }

        const updateIndicator = () => {
          playIndicator.hidden = !video.paused;
        };

        video.addEventListener("play", updateIndicator);
        video.addEventListener("pause", updateIndicator);
        video.addEventListener("ended", updateIndicator);

        wrapper.append(video, playIndicator);
        preview.append(wrapper);

        video.play().catch(() => {
          // Autoplay can be blocked by browser settings.
          updateIndicator();
        });
      } else {
        const image = document.createElement("img");
        image.src = src;
        image.alt = item.dataset.alt ?? "";
        preview.append(image);
      }

      counter.textContent = `${currentIndex + 1} / ${items.length}`;
    };

    items.forEach((item, index) => {
      item.addEventListener("click", () => {
        showMedia(index);
        dialog.showModal();
      });
    });

    previous.addEventListener("click", () => showMedia(currentIndex - 1));
    next.addEventListener("click", () => showMedia(currentIndex + 1));
    close.addEventListener("click", () => dialog.close());

    // With one media item, navigating the lightbox is unnecessary.
    if (items.length === 1) {
      previous.hidden = true;
      next.hidden = true;
    }

    dialog.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft" && items.length > 1) {
        event.preventDefault();
        showMedia(currentIndex - 1);
      } else if (event.key === "ArrowRight" && items.length > 1) {
        event.preventDefault();
        showMedia(currentIndex + 1);
      }
    });

    preview.addEventListener(
      "touchstart",
      (event) => {
        touchStartX = event.changedTouches[0]?.clientX ?? null;
      },
      { passive: true }
    );

    preview.addEventListener(
      "touchend",
      (event) => {
        if (touchStartX === null) return;

        const endX = event.changedTouches[0]?.clientX;
        if (endX === undefined) return;

        const distance = endX - touchStartX;
        touchStartX = null;

        if (Math.abs(distance) < 50 || items.length === 1) return;

        showMedia(currentIndex + (distance < 0 ? 1 : -1));
      },
      { passive: true }
    );

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.addEventListener("close", () => {
      preview.replaceChildren();
      touchStartX = null;
    });
  });
</script>
