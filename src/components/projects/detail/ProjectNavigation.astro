---
import { ArrowLeft, PanelsTopLeft } from "@lucide/astro";

interface Props {
  position?: "top" | "bottom";
}

const { position = "top" } = Astro.props;

const isTop = position === "top";
const projectsUrl = `${import.meta.env.BASE_URL}projects/`;
---

{isTop ? (
  <nav class="project-navigation top-navigation" aria-label="Project navigation">
    <a href={projectsUrl} class="back-link">
      <ArrowLeft size={18} aria-hidden="true" />
      <span>All Projects</span>
    </a>

    <span class="nav-label">
      <PanelsTopLeft size={18} aria-hidden="true" />
      Project Showcase
    </span>
  </nav>
) : (
  <footer class="project-navigation bottom-navigation">
    <a href={projectsUrl} class="back-link">
      <ArrowLeft size={18} aria-hidden="true" />
      <span>Back to All Projects</span>
    </a>
  </footer>
)}

<style>
  .project-navigation {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .top-navigation {
    margin-bottom: 36px;
  }

  .bottom-navigation {
    margin-top: 52px;
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
  }

  .back-link,
  .nav-label {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .back-link {
    color: var(--color-muted);
    font-size: var(--text-label);
    text-decoration: none;
    transition: color 180ms ease;
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .back-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: 2px;
  }

  .nav-label {
    color: var(--color-muted);
    font-size: var(--text-caption);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  @media (max-width: 639px) {
    .top-navigation {
      margin-bottom: 26px;
    }

    .bottom-navigation {
      margin-top: 36px;
    }

    .nav-label {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .back-link {
      transition: none;
    }
  }
</style>
