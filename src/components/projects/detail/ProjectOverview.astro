---
import type { CollectionEntry } from "astro:content";
import { CodeXml, Info } from "@lucide/astro";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;

const { description, focus, technical_highlights } = project.data;

const hasContributions = technical_highlights.length > 0;
---

<div class="project-overview">
  <!-- About -->
  <section class="about-project" aria-labelledby="about-project-title">
    <div class="section-heading">
      <Info size={23} aria-hidden="true" />
      <h2 id="about-project-title">About</h2>
    </div>

    <p class="project-description">{description}</p>

    {focus.length > 0 && (
      <ul class="focus-list" aria-label="Areas of focus">
        {focus.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    )}
  </section>

  <!-- Technical highlights -->
  {hasContributions && (
    <section aria-labelledby="technical-highlights-title">
      <div class="section-heading">
        <CodeXml size={23} aria-hidden="true" />
        <h2 id="technical-highlights-title">My Contributions</h2>
      </div>

      <ul class="highlights-grid">
        {technical_highlights.map((item) => (
          <li>
            <span class="highlight-marker" aria-hidden="true" />
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </section>
  )}
</div>

<style>
  .project-overview {
    display: flex;
    flex-direction: column;
    gap: 56px;
    margin-top: 42px;
    width: 100%;
  }

  .section-heading {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 18px;
  }

  .section-heading :global(svg) {
    flex-shrink: 0;
    color: var(--color-accent);
  }

  .section-heading h2 {
    color: var(--color-foreground);
    font-size: clamp(21px, 2.5vw, 26px);
    line-height: 1.25;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .project-description {
    color: var(--color-muted);
    font-size: 16px;
    line-height: 1.8;
    white-space: pre-line;
  }

  .focus-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 18px;
    padding: 0;
    list-style: none;
  }

  .focus-list li {
    color: var(--color-accent);
    font-size: 12px;
    font-weight: 500;
  }

  .focus-list li + li::before {
    content: "·";
    margin-right: 8px;
    color: var(--color-border-strong);
  }

  .highlights-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 14px 28px;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .highlights-grid li {
    display: flex;
    align-items: baseline;
    gap: 12px;
    color: var(--color-muted);
    line-height: 1.6;
  }

  .highlight-marker {
    width: 6px;
    height: 6px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--color-accent-secondary);
  }

  @media (min-width: 768px) {
    .highlights-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 639px) {
    .project-overview {
      margin-top: 32px;
      gap: 40px;
    }
  }
</style>
