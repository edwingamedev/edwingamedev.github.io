---
import type { CollectionEntry } from "astro:content";
import { CodeXml, Info } from "@lucide/astro";
import SectionHeading from "../../ui/SectionHeading.astro";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { description, focus, technical_highlights } = project.data;

const hasContributions = technical_highlights.length > 0;
---

<div class="project-overview">
  <section aria-labelledby="about-project-title">
    <SectionHeading title="About" id="about-project-title">
      <Info slot="icon" size={23} stroke-width={2} />
    </SectionHeading>

    <p class="project-description">{description}</p>

    {focus.length > 0 && (
      <ul class="focus-list" aria-label="Areas of focus">
        {focus.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    )}
  </section>

  {hasContributions && (
    <section aria-labelledby="technical-highlights-title">
      <SectionHeading title="My Contributions" id="technical-highlights-title">
        <CodeXml slot="icon" size={23} stroke-width={2} />
      </SectionHeading>

      <ul class="highlights-grid">
        {technical_highlights.map((item) => (
          <li>
            <span class="highlight-marker" aria-hidden="true"></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </section>
  )}
</div>

<style>
  .project-overview {
    display: flex;
    flex-direction: column;
    gap: 56px;
    width: 100%;
    margin-top: 42px;
  }

  .project-description {
    color: var(--color-muted);
    font-size: var(--text-body);
    line-height: 1.8;
    white-space: pre-line;
  }

  .focus-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 18px;
    padding: 0;
    list-style: none;
  }

  .focus-list li {
    color: var(--color-accent);
    font-size: var(--text-caption);
    font-weight: 500;
  }

  .focus-list li + li::before {
    content: "·";
    margin-right: 8px;
    color: var(--color-border-strong);
  }

  .highlights-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 14px 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .highlights-grid li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    color: var(--color-muted);
    font-size: var(--text-body);
    line-height: 1.6;
  }

  .highlight-marker {
    width: 6px;
    height: 6px;
    flex-shrink: 0;
    margin-top: 0.65em;
    border-radius: 50%;
    background: var(--color-accent-secondary);
  }

  @media (min-width: 768px) {
    .highlights-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 639px) {
    .project-overview {
      margin-top: 32px;
      gap: 40px;
    }
  }
</style>
