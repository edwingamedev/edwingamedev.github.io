---
interface Props {
  src: string;
  alt: string;
  class?: string;
  loading?: "lazy" | "eager";
  fetchpriority?: "high" | "low" | "auto";
}

const { src, alt, class: className = "", loading = "lazy", fetchpriority } = Astro.props;

const isVideo = /\.(webm|mp4)(?:[?#]|$)/i.test(src);
---

{isVideo ? (
  <video
    class:list={["block h-full w-full object-cover", className]}
    data-project-video
    muted
    loop
    playsinline
    preload={loading === "eager" ? "metadata" : "none"}
    aria-label={alt}
  >
    <source src={src} type={src.toLowerCase().includes(".webm") ? "video/webm" : "video/mp4"} />
    Your browser does not support video playback.
  </video>
) : (
  <img
    src={src}
    alt={alt}
    loading={loading}
    decoding="async"
    class:list={["block h-full w-full object-cover", className]}
    fetchpriority={fetchpriority}
  />
)}

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        const video = entry.target as HTMLVideoElement;

        if (entry.isIntersecting) {
          video.play().catch(() => {
            // Playback may be blocked by browser settings.
          });
        } else {
          video.pause();
        }
      }
    },
    {
      threshold: 0.25,
    }
  );

  const observeVideos = (root: ParentNode = document) => {
    root.querySelectorAll<HTMLVideoElement>("video[data-project-video]").forEach((video) => {
      if (video.dataset.videoObserved === "true") return;

      video.dataset.videoObserved = "true";
      observer.observe(video);
    });
  };

  observeVideos();

  const mutationObserver = new MutationObserver((mutations) => {
    for (const mutation of mutations) {
      for (const node of mutation.addedNodes) {
        if (!(node instanceof Element)) continue;

        if (node.matches("video[data-project-video]")) {
          observeVideos(node.parentElement ?? document);
        } else {
          observeVideos(node);
        }
      }
    }
  });

  mutationObserver.observe(document.querySelector("[data-carousel]") ?? document.body, {
    childList: true,
    subtree: true,
  });
</script>
