---
import Container from "../ui/Container.astro";

const startYear = 2018;
const currentYear = new Date().getFullYear();

const years = currentYear > startYear ? `${startYear}–${currentYear}` : `${startYear}`;
---

<footer class="site-footer">
  <Container>
    <div class="footer-content">
      <span class="footer-accent" aria-hidden="true"></span>

      <p class="footer-copyright">&copy; {years} Edwin Game Dev</p>
    </div>
  </Container>
</footer>

<style>
  .site-footer {
    margin-top: 24px;
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .footer-content {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 24px 0;
  }

  .footer-accent {
    width: 24px;
    height: 3px;
    flex-shrink: 0;
    border-radius: 2px;
    background: var(--color-accent);
  }

  .footer-copyright {
    margin: 0;
    color: var(--color-foreground);
    font-size: var(--text-label);
    font-weight: 500;
    line-height: 1.5;
  }

  @media (max-width: 639px) {
    .site-footer {
      margin-top: 16px;
    }

    .footer-content {
      gap: 12px;
      padding: 22px 0;
    }
  }
</style>
