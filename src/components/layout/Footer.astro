---
import Container from "../ui/Container.astro";
import { Mail, FileText } from "@lucide/astro";
import SectionHeading from "../ui/SectionHeading.astro";
import "@fortawesome/fontawesome-free/css/all.min.css";

import contacts from "../../data/contact.yml";

type ContactIcon = "mail" | "resume" | "linkedin" | "github" | "gamejolt";

interface ContactLink {
  label: string;
  icon: ContactIcon;
  href: string;
}

const contactLinks = contacts as ContactLink[];

const startYear = 2018;
const currentYear = new Date().getFullYear();
const years = currentYear > startYear ? `${startYear}–${currentYear}` : `${startYear}`;
---

<footer id="contact" class="site-footer">
  <Container>
    <div class="footer-content">
      <div class="footer-contact">
        <SectionHeading title="Contact" id="contact-title" spacing="relaxed">
          <Mail slot="icon" size={24} stroke-width={2} />
        </SectionHeading>
        <p>
          Interested in working together or discussing game development? Feel free to reach out.
        </p>

        <nav class="contact-links" aria-label="Contact links">
          {contactLinks.map((contact) => {
            const external = !contact.href.startsWith("mailto:");

            return (
              <a
                href={contact.href}
                target={external ? "_blank" : undefined}
                rel={external ? "noopener noreferrer" : undefined}
              >
                {contact.icon === "mail" && (
                  <Mail size={18} stroke-width={1.8} aria-hidden="true" />
                )}

                {contact.icon === "resume" && (
                  <FileText size={18} stroke-width={1.8} aria-hidden="true" />
                )}

                {contact.icon === "linkedin" && (
                  <i class="fa-brands fa-linkedin" aria-hidden="true"></i>
                )}

                {contact.icon === "github" && (
                  <i class="fa-brands fa-github" aria-hidden="true"></i>
                )}

                {contact.icon === "gamejolt" && (
                  <span
                    class="gamejolt-icon"
                    style={`--icon-url: url("${import.meta.env.BASE_URL}assets/images/gamejolt.png")`}
                    aria-hidden="true"
                  />
                )}

                <span>{contact.label}</span>
              </a>
            );
          })}
        </nav>
      </div>

      <div class="footer-bottom">
        <span class="footer-accent" aria-hidden="true"></span>
        <p class="footer-copyright">&copy; {years} Edwin Game Dev</p>
      </div>
    </div>
  </Container>
</footer>

<style>
  .site-footer {
    margin-top: 24px;
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .footer-content {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding: 32px 0 24px;
  }

  .footer-contact h2 {
    margin: 0 0 12px;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-foreground);
  }

  .footer-contact p {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-body);
    line-height: 1.8;
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
  }

  .contact-links a {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 9px 13px;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    color: var(--color-muted);
    font-size: var(--text-label);
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    transition:
      border-color 180ms ease,
      color 180ms ease,
      background 180ms ease;
  }

  .contact-links a :global(svg),
  .contact-links a :global(i) {
    flex-shrink: 0;
    color: var(--color-accent);
  }

  .contact-links a :global(i) {
    width: 18px;
    text-align: center;
    font-size: 17px;
  }

  .contact-links a:hover {
    border-color: var(--color-border-strong);
    background: var(--color-surface);
    color: var(--color-foreground);
  }

  .contact-links a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .gamejolt-icon {
    display: inline-block;
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    background-color: var(--color-accent);
    -webkit-mask-image: var(--icon-url);
    mask-image: var(--icon-url);
    -webkit-mask-size: contain;
    mask-size: contain;
    -webkit-mask-position: center;
    mask-position: center;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-top: 20px;
    border-top: 1px solid var(--color-border);
  }

  .footer-accent {
    width: 24px;
    height: 3px;
    flex-shrink: 0;
    border-radius: 2px;
    background: var(--color-accent);
  }

  .footer-copyright {
    margin: 0;
    color: var(--color-foreground);
    font-size: var(--text-label);
    font-weight: 500;
    line-height: 1.5;
  }

  @media (max-width: 639px) {
    .site-footer {
      margin-top: 16px;
    }

    .footer-content {
      gap: 24px;
      padding: 28px 0 22px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-links a {
      transition: none;
    }
  }
</style>
