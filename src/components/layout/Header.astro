---
import Container from "../ui/Container.astro";
import ThemeSwitcher from "../ui/ThemeSwitcher.astro";
import Navbar from "./Navbar.astro";

import { Menu, X } from "@lucide/astro";
---

<header class="sticky top-0 z-50 border-b border-border bg-page">
  <Container>
    <div class="flex min-h-16 items-center justify-between gap-4">
      <a
        href={import.meta.env.BASE_URL}
        class="shrink-0 font-bold tracking-wide text-foreground focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
      >
        EDWIN<span class="text-accent">.GAMEDEV</span>
      </a>

      <!-- Desktop -->
      <div class="hidden items-center gap-6 md:flex">
        <Navbar />

        <div class="border-l border-border pl-6">
          <ThemeSwitcher />
        </div>
      </div>

      <!-- Mobile -->
      <div class="flex items-center gap-3 md:hidden">
        <ThemeSwitcher />

        <details class="mobile-menu relative">
          <summary
            class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-md border border-border text-foreground transition-colors hover:border-border-strong hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
            aria-label="Toggle navigation menu"
          >
            <Menu class="menu-open-icon" size={20} aria-hidden="true" />
            <X class="menu-close-icon" size={20} aria-hidden="true" />
          </summary>

          <div class="absolute top-12 right-0 z-50 min-w-44 rounded-lg border border-border bg-surface p-3 shadow-lg">
            <Navbar variant="mobile" />
          </div>
        </details>
      </div>
    </div>
  </Container>
</header>

<style>
  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .menu-close-icon {
    display: none;
  }

  .mobile-menu[open] .menu-open-icon {
    display: none;
  }

  .mobile-menu[open] .menu-close-icon {
    display: block;
  }
</style>

<script>
  const mobileMenu = document.querySelector<HTMLDetailsElement>(".mobile-menu");

  if (mobileMenu) {
    const desktopQuery = window.matchMedia("(min-width: 768px)");

    const closeMenu = () => {
      mobileMenu.open = false;
    };

    // Close after selecting a navigation link.
    mobileMenu.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    // Close when clicking or tapping outside the menu.
    document.addEventListener("pointerdown", (event) => {
      if (!mobileMenu.open) return;

      if (!mobileMenu.contains(event.target as Node)) {
        closeMenu();
      }
    });

    // Close when pressing Escape.
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && mobileMenu.open) {
        closeMenu();
        mobileMenu.querySelector("summary")?.focus();
      }
    });

    // Prevent the menu from remaining open when switching to desktop.
    desktopQuery.addEventListener("change", (event) => {
      if (event.matches) {
        closeMenu();
      }
    });
  }
</script>
