---
import Section from "../ui/Section.astro";
import Button from "../ui/Button.astro";
import { FileText, ExternalLink } from "@lucide/astro";
import contacts from "../../data/contact.yml";

const resumeUrl = contacts.find((contact) => contact.icon === "resume")?.href;
---

<Section id="home" spacing="hero">
  <div class="hero">
    <img
      src="/assets/images/logo.png"
      alt="Edwin Holanda pixel art Game Boy logo"
      width="280"
      height="280"
      loading="eager"
      fetchpriority="high"
      class="hero-logo h-auto object-contain [image-rendering:pixelated]"
    />

    <div class="hero-content">
      <div class="hero-heading">
        <p class="hero-role">Senior Game Developer</p>

        <h1 class="text-4xl leading-tight font-bold tracking-tight sm:text-5xl lg:text-6xl">
          Edwin Holanda
        </h1>
      </div>

      <p class="hero-description">
        I build gameplay systems, LiveOps features, and development tools, combining technical
        expertise with a passion for creating games.
      </p>

      <div class="hero-actions">
        <Button href="/projects/">Explore Projects</Button>
        <Button href="#contact" variant="secondary">
          Contact
        </Button>
      </div>

      {resumeUrl && (
        <a href={resumeUrl} target="_blank" rel="noopener noreferrer" class="hero-resume">
          <FileText size={18} stroke-width={1.8} aria-hidden="true" />
          <span>View Resume</span>
          <ExternalLink size={14} stroke-width={1.8} aria-hidden="true" />
        </a>
      )}
    </div>
  </div>
</Section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: 28px;
  }

  .hero-logo {
    width: 100%;
    max-width: 240px;
    justify-self: center;
  }

  .hero-content {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    text-align: center;
  }

  .hero-heading {
    min-width: 0;
  }

  .hero-role {
    margin-bottom: 16px;
    color: var(--color-accent);
    font-size: var(--text-body);
    font-weight: 600;
    letter-spacing: 0.025em;
  }

  .hero-specialties {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 16px;
    color: var(--color-muted);
    font-size: 14px;
    line-height: 1.6;
  }

  .hero-specialties span {
    color: var(--color-accent-secondary);
  }

  .hero-description {
    max-width: 900px;
    margin: 0;
    color: var(--color-muted);
    font-size: 16px;
    line-height: 1.8;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  @media (min-width: 768px) {
    .hero {
      grid-template-columns: minmax(0, 1.618fr) minmax(0, 1fr);
      gap: 40px;
    }

    .hero-content {
      grid-column: 1;
      grid-row: 1;
      align-items: flex-start;
      text-align: left;
    }

    .hero-logo {
      grid-column: 2;
      grid-row: 1;
      max-width: 280px;
    }

    .hero-specialties,
    .hero-actions {
      justify-content: flex-start;
    }
  }

  .hero-resume {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--color-muted);
  font-size: var(--text-label);
  font-weight: 600;
  text-decoration: none;
  transition: color 180ms ease;
}

.hero-resume:hover {
  color: var(--color-accent);
}

.hero-resume:focus-visible {
  outline: 2px solid var(--color-accent);
  outline-offset: 4px;
  border-radius: 2px;
}

@media (prefers-reduced-motion: reduce) {
  .hero-resume {
    transition: none;
  }
}
</style>
